# Python cache files.
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.eggs/
dist/
build/

# Local Python environments.
_metroid_bread_venv/
**/_metroid_bread_venv/
_metroid_dread_venv/
.venv/
**/.venv/
venv/

# The Hub installs npm and Electron files locally.
node_modules/
**/node_modules/
dread-client-app/node_modules/
dread-client-app/dist/
dread-client-app/out/
dread-client-app/release/
dread-client-app/.vite/
.vite/
.cache/

# Store portable Node and Python in Archipelago's custom_worlds folder.
# Do not put them in this world folder.
# Including them added about 7,000 files and over 80 MB.
custom_worlds/
**/_metroid_bread_runtime/
**/_metroid_dread_runtime/
**/tools/node-*/
**/tools/python-*/
*.pdb

# Local settings, logs, and output files.
*.log
logs/
output/
dread_client_ui_config.json
dread_direct_patch_config.json

# Editor and operating system files.
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~

# Ignore large files that local builds recreate.
# Keep icons.bctex and the PNG files in assets.
/docs

# Local tests are not included in the apworld.
/test/
docs/CAUSE_OF_DEATH_MATRIX.md

# Ignore ExeFS backups; keep the live subsdk9 file.
exlaunch/deploy/subsdk9.bak*
exlaunch/deploy/*.bak*
**/subsdk9.bak*
