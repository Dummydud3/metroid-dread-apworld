# Electron's postinstall downloads the platform binary (install.js).
# Never skip lifecycle scripts for this Hub app.
ignore-scripts=false

# npm 11.16+ / 12 install-scripts / allowScripts policy:
# Hub only needs Electron's postinstall; escape hatch keeps installs working
# even before allowScripts entries are present (older trees / fresh clones).
# Older npm versions ignore unknown keys.
dangerously-allow-all-scripts=true
