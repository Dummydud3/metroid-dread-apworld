# Include the Hub source files in the apworld.
# Leave out installed packages, builds, and caches.
# Install npm packages when the Hub first starts.

# Installed npm and Electron files.
node_modules/
**/node_modules/

# Git history inside the world folder.
.git/
**/.git/

# Local caches, output files, and logs.
output/
logs/
*.log
.pytest_cache/
.mypy_cache/
.ruff_cache/
.vite/
.cache/

# The Linux client creates its Python environment at runtime.
_metroid_bread_venv/
**/_metroid_bread_venv/
.venv/
**/.venv/

# Keep portable Node and Python in Archipelago's custom_worlds folder.
# Do not include them in the world package.
# Including them made the package 84 MB instead of about 2.5 MB.
custom_worlds/
**/_metroid_bread_runtime/
**/tools/node-*/
**/tools/python-*/
*.pdb

# Local Electron builds.
dread-client-app/dist/
dread-client-app/out/
dread-client-app/release/
dread-client-app/.vite/

# Editor and operating system files.
.idea/
.vscode/
*.swp
Thumbs.db

# Exclude build backups; keep subsdk9 and main.npdm.
exlaunch/deploy/subsdk9.bak*
exlaunch/deploy/*.bak*
**/subsdk9.bak*

# Exclude local Python and Hub tests.
/test/
dread-client-app/test_*.js

# Exclude local tools for rebuilding and testing.
/tools/

# Exclude the old HK autosave experiment.
dread_scripts/hk_autosave/

# Exclude docs and debug images.
/docs/
*.md
CAUSE_OF_DEATH_MATRIX.md
assets/*_preview.png
assets/*_roundtrip.png

# Exclude old PopTracker map files.
dread-client-app/visualizer/mapping.json
dread-client-app/visualizer/images/

# Exclude local Hub and patcher settings.
/dread_client_ui_config.json
/dread_direct_patch_config.json

# Exclude the station warp debug backup.
/_station_warp_bak/
/archive/
/assets/debug/
